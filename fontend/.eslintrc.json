{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:react/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": ["react", "react-hooks", "import"],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "error",
    "import/no-unresolved": "error"
  },
  "settings": {
    "react": {
      "version": "detect"
    }
  }
}
